# Copie ce fichier en ".env" (même dossier que docker-compose.yml) pour un test local.
# Sur Render, ces mêmes variables se règlent dans le dashboard Render (Environment).

# URL de connexion Postgres Neon : https://neon.tech (gratuit, sans carte)
# Format : postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Clé API Gemini gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Identifiants d'accès au dashboard (l'app est publique une fois déployée en ligne)
SENTINEL_USERNAME=admin
SENTINEL_PASSWORD=change-moi
